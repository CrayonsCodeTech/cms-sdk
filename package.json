{
  "name": "@crayons/cms-sdk",
  "version": "0.5.0",
  "description": "CMS SDK for fetching data and shared types",
  "type": "module",
  "main": "dist/index.cjs",
  "module": "dist/index.mjs",
  "types": "dist/index.d.cts",
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "prepare": "pnpm build",
    "lint": "eslint src/**/*.ts"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.cts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "keywords": [
    "cms",
    "sdk",
    "nextjs",
    "fetch"
  ],
  "author": "Crayons",
  "license": "ISC",
  "devDependencies": {
    "@types/react": "^19.2.14",
    "tsdown": "latest",
    "typescript": "^6.0.3"
  },
  "peerDependencies": {
    "lucide-react": "^1.14.0",
    "next": ">=13.0.0",
    "react": ">=18.0.0",
    "react-dom": ">=18.0.0"
  },
  "dependencies": {
    "lucide-react": "^1.14.0"
  },
  "peerDependenciesMeta": {
    "next": {
      "optional": true
    }
  }
}