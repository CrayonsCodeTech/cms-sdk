{
  "name": "@crayonscodetech/cms-sdk",
  "version": "1.0.8",
  "description": "CMS SDK for fetching data and shared types",
  "keywords": [
    "cms",
    "sdk",
    "nextjs",
    "crayons"
  ],
  "homepage": "https://github.com/CrayonsCodeTech/cms-sdk#readme",
  "bugs": {
    "url": "https://github.com/CrayonsCodeTech/cms-sdk/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/CrayonsCodeTech/cms-sdk.git"
  },
  "license": "MIT",
  "author": "Crayons",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.cts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs"
    }
  },
  "main": "dist/index.cjs",
  "types": "dist/index.d.cts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "prepare": "pnpm build",
    "lint": "eslint src/**/*.ts",
    "doctor": "npx react-doctor@latest"
  },
  "dependencies": {
    "lucide-react": "^1.32.0"
  },
  "devDependencies": {
    "@types/react": "^19.2.18",
    "tsdown": "latest",
    "typescript": "^6.0.3"
  },
  "peerDependencies": {
    "lucide-react": "^1.14.0",
    "next": ">=13.0.0",
    "react": ">=18.0.0",
    "react-dom": ">=18.0.0"
  },
  "peerDependenciesMeta": {
    "next": {
      "optional": true
    }
  },
  "module": "dist/index.mjs"
}
